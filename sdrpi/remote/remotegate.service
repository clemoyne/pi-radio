[Unit]
Description=Gate between the Cloudflare tunnel and the Pis' pages (sign-in check, owner-only controls)
After=network-online.target
RequiresMountsFor=/mnt/data
StartLimitIntervalSec=0

[Service]
User=pi
NoNewPrivileges=yes
ExecStart=/usr/bin/python3 -I /mnt/data/remotegate/app/remotegate.py
Restart=always
RestartSec=10
StandardOutput=append:/mnt/data/logs/remotegate.log
StandardError=append:/mnt/data/logs/remotegate.log
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
