[Unit]
Description=Passive BLE presence tracker
After=bluetooth.service hciuart.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 -I /opt/bletracker/bletracker.py
Restart=always
RestartSec=60
DynamicUser=yes
StateDirectory=bletracker
RuntimeDirectory=bletracker
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
OOMScoreAdjust=800
LimitAS=128M

[Install]
WantedBy=multi-user.target
